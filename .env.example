# ---- Meta WhatsApp Cloud API ----
# Get these from developers.facebook.com -> Your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_yourself

# ---- Google Gemini API ----
# Get this free from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ---- Upstash Redis ----
# Get these free from https://console.upstash.com
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ---- Server ----
PORT=3000
